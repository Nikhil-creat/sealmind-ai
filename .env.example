# Add ONE or BOTH free keys. Provider is auto-detected from the key prefix
# (gsk_ = Groq, AIza = Gemini) and the model is auto-selected. No model setting needed.
# Groq: console.groq.com/keys   Gemini: aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional: AI_API_KEY accepts either kind. GROQ_MODEL / GEMINI_MODEL are optional overrides.
AI_API_KEY=
